# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# JWT Secret
SECRET_KEY=your-secret-key-here

# Blockchain Configuration (Ethereum Sepolia Testnet)
# Get free RPC endpoint from: https://www.alchemy.com/ (100k requests/day free)
ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Blockchain wallet private key (DO NOT SHARE!)
# Create wallet in MetaMask and export private key
# Get free Sepolia ETH from: https://sepoliafaucet.com/
BLOCKCHAIN_PRIVATE_KEY=0xyour_private_key_here

# Contract address (filled after deployment)
BLOCKCHAIN_CONTRACT_ADDRESS=

# Optional: Etherscan API key for contract verification
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: IPFS Configuration (Alchemy IPFS or other provider)
# For decentralized file storage (optional but recommended)
ALCHEMY_IPFS_API_KEY=
ALCHEMY_IPFS_API_SECRET=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
